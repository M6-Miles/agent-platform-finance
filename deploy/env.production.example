APP_ENV=production
AUTH_ENABLED=true
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_TOKEN_TTL_S=28800
AUTH_REGISTRATION_ENABLED=true

ALLOWED_ORIGINS=http://YOUR_SERVER_IP_OR_DOMAIN
TRUSTED_HOSTS=YOUR_SERVER_IP_OR_DOMAIN,127.0.0.1,localhost

SQLITE_PATH=data/app.sqlite3
LANGGRAPH_USE_MEMORY_SAVER=false

LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

MARKET_DATA_PROVIDER=akshare
PAPER_MONITOR_ENABLED=false
PAPER_MONITOR_POLL_INTERVAL_S=30
