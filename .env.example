# 本地演示版默认不需要真实大模型 Key。
# 复制为 .env 后可以按需调整；不要把真实密钥提交到代码仓库。

APP_NAME="通用 Agent 平台及证券金融分析应用"
APP_ENV="local"
SAMPLE_PRICES_CSV="data/sample/prices.csv"
SQLITE_PATH="data/app.sqlite3"

# Enterprise authentication. Production refuses to start unless enabled with
# an independent random secret of at least 32 characters.
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_TOKEN_TTL_S=28800
# Local/demo can enable self-registration. Keep false in production unless required.
AUTH_REGISTRATION_ENABLED=false
ALLOWED_ORIGINS=http://127.0.0.1:8003,http://localhost:8003
TRUSTED_HOSTS=127.0.0.1,localhost

# LLM 模型选择：mock（离线 Mock，默认）、deepseek 或 claude
LLM_PROVIDER="mock"
# DEEPSEEK_API_KEY="sk-..."
# DEEPSEEK_MODEL="deepseek-chat"
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# 行情数据源：sample（内置样例，默认）或 akshare（AkShare A股日线，需联网）
MARKET_DATA_PROVIDER="sample"

# LangGraph checkpoint 模式
# 默认 false（使用 SQLite）：checkpoint 写磁盘，interrupt 可跨进程/跨实例恢复。
# true 仅供单测/临时开发：使用 MemorySaver，进程退出后 interrupt 状态丢失，
#   无法通过重建 ApplicationService 恢复审批链路，不得用于生产。
LANGGRAPH_USE_MEMORY_SAVER=false

# 长期模拟盘监控：显式启用后，后端按任务设定时间每日采集一次真实/离线行情。
# Set true to start the background trading-day evidence scheduler. When false,
# monitor jobs remain persisted and can still be run manually from the UI.
PAPER_MONITOR_ENABLED=false
PAPER_MONITOR_POLL_INTERVAL_S=30

# 预留字段
# TUSHARE_TOKEN=""
